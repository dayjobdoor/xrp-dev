{
  "name": "xrp-dev-wallet",
  "private": true,
  "version": "0.1.0-alpha.0",
  "description": "The only key-holding package of xrp-dev: XRPL wallets from entropy and secret numbers, plus an xrpl-connect passkey adapter.",
  "keywords": ["xrpl", "xrp", "wallet", "passkey", "webauthn", "xrpl-connect", "effect", "cloudflare-workers"],
  "homepage": "https://github.com/dayjobdoor/xrp-dev/tree/main/packages/wallet#readme",
  "bugs": "https://github.com/dayjobdoor/xrp-dev/issues",
  "repository": { "type": "git", "url": "git+https://github.com/dayjobdoor/xrp-dev.git", "directory": "packages/wallet" },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./passkey": { "types": "./dist/passkey.d.ts", "default": "./dist/passkey.js" },
    "./package.json": "./package.json"
  },
  "engines": { "node": ">=20.19" },
  "files": ["dist", "README.md", "LICENSE"],
  "dependencies": {
    "xrp-dev": "workspace:^"
  },
  "peerDependencies": {
    "effect": "^4.0.2",
    "xrpl": "^4.0.0 || ^5.0.0",
    "xrpl-connect": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "xrpl": { "optional": true },
    "xrpl-connect": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@xrplf/secret-numbers": "^3.0.0",
    "effect": "^4.0.2",
    "fast-check": "^4.10.2",
    "ripple-keypairs": "^3.1.0",
    "vite-plus": "1.1.0",
    "xrpl": "^5.3.0",
    "xrpl-connect": "1.0.0"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run"
  }
}
