{
  "name": "xrp-dev-mcp",
  "private": true,
  "version": "0.1.0-alpha.2",
  "description": "XRPL tool registry for MCP servers, plus a stdio server (xrp-dev-mcp) for Node and Bun. Reads and prepares; never signs.",
  "keywords": [
    "xrpl",
    "xrp",
    "mcp",
    "model-context-protocol",
    "cloudflare-workers",
    "effect",
    "agent"
  ],
  "homepage": "https://github.com/dayjobdoor/xrp-dev/tree/main/packages/mcp#readme",
  "bugs": "https://github.com/dayjobdoor/xrp-dev/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayjobdoor/xrp-dev.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "xrp-dev": "workspace:^"
  },
  "peerDependencies": {
    "effect": "^4.0.2"
  },
  "scripts": {
    "build": "rm -rf dist && vp pack",
    "test": "vp test run"
  },
  "devDependencies": {
    "vite-plus": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.5",
    "xrp-dev-wallet": "workspace:*",
    "effect": "^4.0.2"
  }
}
